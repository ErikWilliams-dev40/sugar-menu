{
  "name": "sugar-menu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mts",
    "test:smoke": "node tests/smoke.mts",
    "format": "prettier --write src tests package.json tsconfig.json *.mjs *.ts README.md docs/PHASE_0.md docs/RECREATION.md",
    "format:check": "prettier --check src tests package.json tsconfig.json *.mjs *.ts README.md docs/PHASE_0.md docs/RECREATION.md",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
