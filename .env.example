# No CMS or newsletter credentials are needed for this preview.
# Future secrets must stay server-side (no NEXT_PUBLIC_ prefix).
#
# Canonical origin, no path or trailing slash.
# Required when SITE_INDEXABLE=true. Unset uses http://localhost:3000.
SITE_URL=

# Set to true and rebuild to allow indexing. Any other value stays noindex.
SITE_INDEXABLE=

# allow or deny. When unset, AI crawlers follow SITE_INDEXABLE.
# Agents: GPTBot, OAI-SearchBot, PerplexityBot, ClaudeBot, Google-Extended.
AI_CRAWLER_POLICY=

# Google Search Console HTML-tag token only. Leave empty until the team has one.
GOOGLE_SITE_VERIFICATION=
